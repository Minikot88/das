# Frontend runtime mode.
# true keeps the app in explicit local/demo mode with mock auth and localStorage data.
# false expects a real API behind VITE_API_BASE_URL or the Vite dev proxy.
VITE_USE_MOCK=false

# Optional same-origin API base path for non-mock mode, for example /api.
# The standalone nginx image intentionally permits same-origin connections only.
VITE_API_BASE_URL=

# Development-only proxy target used by Vite when VITE_API_BASE_URL is blank.
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_API_TIMEOUT_MS=15000

# Docker bind address and host port for the nginx frontend container.
# Keep the loopback default for local/demo data. Set 0.0.0.0 only when an
# outer HTTPS/authentication boundary and the documented backend controls exist.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080

# Backend and MariaDB. Defaults are local-development only; replace every
# password/key before any shared or production deployment.
NODE_ENV=development
AUTH_PROVIDER=development
MARIADB_DATABASE=dashboard_mini_bi
MARIADB_USER=dashboard
MARIADB_PASSWORD=dashboard-local-only
MARIADB_ROOT_PASSWORD=root-local-only
SECRET_MASTER_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
SESSION_SIGNING_KEY=YmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmI=
DEVELOPMENT_AUTH_EMAIL=dev@example.com
DEVELOPMENT_AUTH_PASSWORD=development-password
CORS_ORIGINS=http://localhost:8080
