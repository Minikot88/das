}

model DashboardShareSnapshot {
  id                String   @id @db.VarChar(64)
  shareId           String   @map("share_id") @db.VarChar(64)
  dashboardRevision Int      @map("dashboard_revision")
  snapshotJson      Json     @map("snapshot_json")
  checksum          String   @db.Char(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  @@unique([shareId], map: "uq_dashboard_share_snapshots_share")
  @@map("dashboard_share_snapshots")
}

model DashboardShareAccessLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  shareId    String   @map("share_id") @db.VarChar(64)
  requestId  String   @map("request_id") @db.VarChar(64)
  origin     String?  @db.VarChar(255)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  outcome    String   @db.VarChar(32)
  accessedAt DateTime @default(now()) @map("accessed_at") @db.DateTime(3)
  @@index([shareId, accessedAt], map: "idx_dashboard_share_access_logs_share")
  @@map("dashboard_share_access_logs")
}

model EmbedSetting {
  id             String @id @db.VarChar(64)
  shareId        String @unique @map("share_id") @db.VarChar(64)
  showHeader     Boolean @default(false) @map("show_header")
  theme          String @default("auto") @db.VarChar(20)
  optionsJson    Json?  @map("options_json")
  @@map("embed_settings")
}

model ExportJob {
  id             String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.VarChar(64)
  projectId      String   @map("project_id") @db.VarChar(64)
  requestedBy    String   @map("requested_by") @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(40)
  entityId       String   @map("entity_id") @db.VarChar(64)
  format         String   @db.VarChar(20)
  status         String   @default("pending") @db.VarChar(32)
  optionsJson    Json?    @map("options_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)
  @@index([projectId, createdAt], map: "idx_export_jobs_project")
  @@map("export_jobs")
}

model ExportFile {
  id        String   @id @db.VarChar(64)
  exportId  String   @map("export_id") @db.VarChar(64)
  fileId    String   @map("file_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  @@unique([exportId, fileId], map: "uq_export_files")
  @@map("export_files")
}

model UserPreference {
  id             String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.VarChar(64)
  userId         String   @map("user_id") @db.VarChar(64)
  locale         String   @default("th") @db.VarChar(20)
  theme          String   @default("system") @db.VarChar(20)
  density        String   @default("comfortable") @db.VarChar(20)
  dateFormat     String   @default("MMM d, yyyy") @map("date_format") @db.VarChar(40)
  numberFormat   String   @default("compact") @map("number_format") @db.VarChar(40)
  preferencesJson Json?   @map("preferences_json")
  revision       Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([organizationId, userId], map: "uq_user_preferences_org_user")
  @@map("user_preferences")
}

model FileRecord {
  id             String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.VarChar(64)
  projectId      String?  @map("project_id") @db.VarChar(64)
  ownerUserId    String   @map("owner_user_id") @db.VarChar(64)
  provider       String   @db.VarChar(40)
  storageKey     String   @unique @map("storage_key") @db.VarChar(500)
  filename       String   @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  sizeBytes      BigInt   @map("size_bytes") @db.UnsignedBigInt
  checksum       String   @db.Char(64)
  retentionUntil DateTime? @map("retention_until") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  @@index([organizationId, projectId, createdAt], map: "idx_files_scope")
  @@map("files")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId String   @map("organization_id") @db.VarChar(64)
  projectId      String?  @map("project_id") @db.VarChar(64)
  actorUserId    String?  @map("actor_user_id") @db.VarChar(64)
  requestId      String   @map("request_id") @db.VarChar(64)
  entityType     String?  @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  action         String   @db.VarChar(120)
  outcome        String   @db.VarChar(32)
  metadataJson   Json?    @map("metadata_json")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  @@index([organizationId, occurredAt, id], map: "idx_audit_logs_org_time")
  @@index([organizationId, entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model ErrorLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId String?  @map("organization_id") @db.VarChar(64)
  requestId      String   @map("request_id") @db.VarChar(64)
  code           String   @db.VarChar(80)
  safeMessage    String   @map("safe_message") @db.VarChar(500)
  metadataJson   Json?    @map("metadata_json")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  @@index([occurredAt, id], map: "idx_error_logs_time")
  @@map("error_logs")
}

model ApiRequestLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  organizationId String?  @map("organization_id") @db.VarChar(64)
  userId         String?  @map("user_id") @db.VarChar(64)
  requestId      String   @unique @map("request_id") @db.VarChar(64)
  method         String   @db.VarChar(12)
  path           String   @db.VarChar(500)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  @@index([organizationId, occurredAt, id], map: "idx_api_request_logs_org_time")
  @@map("api_request_logs")
}
