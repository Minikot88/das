model SqlQueryResult {
  id        String   @id @db.VarChar(64)
  runId     String   @unique @map("run_id") @db.VarChar(64)
  rowCount  Int      @map("row_count")
  truncated Boolean  @default(false)
  expiresAt DateTime? @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  @@map("sql_query_results")
}

model SqlQueryResultColumn {
  id         String @id @db.VarChar(64)
  resultId   String @map("result_id") @db.VarChar(64)
  name       String @db.VarChar(191)
  dataType   String @map("data_type") @db.VarChar(80)
  ordinal    Int
  @@unique([resultId, ordinal], map: "uq_sql_query_result_columns")
  @@map("sql_query_result_columns")
}

model SqlQueryResultRow {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  resultId  String @map("result_id") @db.VarChar(64)
  rowNumber Int    @map("row_number")
  rowJson   Json   @map("row_json")
  @@unique([resultId, rowNumber], map: "uq_sql_query_result_rows")
  @@map("sql_query_result_rows")
}

model DashboardShareLink {
