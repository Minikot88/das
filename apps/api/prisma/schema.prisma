  userId          String      @map("user_id") @db.VarChar(64)
  locale          String      @default("th") @db.VarChar(20)
  theme           String      @default("system") @db.VarChar(20)
  density         String      @default("comfortable") @db.VarChar(20)
  dateFormat      String      @default("MMM d, yyyy") @map("date_format") @db.VarChar(40)
  numberFormat    String      @default("compact") @map("number_format") @db.VarChar(40)
  preferencesJson Json?       @map("preferences_json")
  revision        Int         @default(0)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user_profiles   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "uq_user_preferences_org_user")
  @@map("user_preferences")
  @@schema("dashboard_core")
}

model FileRecord {
  id             String       @id @db.VarChar(64)
  organizationId String       @map("organization_id") @db.VarChar(64)
  projectId      String?      @map("project_id") @db.VarChar(64)
  ownerUserId    String       @map("owner_user_id") @db.VarChar(64)
  provider       String       @db.VarChar(40)
  storageKey     String       @unique @map("storage_key") @db.VarChar(500)
  filename       String       @db.VarChar(255)
  mimeType       String       @map("mime_type") @db.VarChar(120)
  sizeBytes      BigInt       @map("size_bytes")
  checksum       String       @db.Char(64)
  retentionUntil DateTime?    @map("retention_until") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  export_files   ExportFile[]
  bi_projects    BiProject?   @relation(fields: [projectId], references: [id])
  import_jobs    ImportJob[]

  @@index([organizationId, projectId, createdAt], map: "idx_files_scope")
  @@map("files")
  @@schema("dashboard_core")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.VarChar(64)
  projectId      String?  @map("project_id") @db.VarChar(64)
  actorUserId    String?  @map("actor_user_id") @db.VarChar(64)
  requestId      String   @map("request_id") @db.VarChar(64)
  entityType     String?  @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  action         String   @db.VarChar(120)
  outcome        String   @db.VarChar(32)
  metadataJson   Json?    @map("metadata_json")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, occurredAt, id], map: "idx_audit_logs_org_time")
  @@index([organizationId, entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
  @@schema("dashboard_core")
}

model ErrorLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.VarChar(64)
  requestId      String   @map("request_id") @db.VarChar(64)
  code           String   @db.VarChar(80)
  safeMessage    String   @map("safe_message") @db.VarChar(500)
  metadataJson   Json?    @map("metadata_json")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([occurredAt, id], map: "idx_error_logs_time")
  @@map("error_logs")
  @@schema("dashboard_core")
}

model ApiRequestLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.VarChar(64)
  userId         String?  @map("user_id") @db.VarChar(64)
  requestId      String   @unique @map("request_id") @db.VarChar(64)
  method         String   @db.VarChar(12)
  path           String   @db.VarChar(500)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, occurredAt, id], map: "idx_api_request_logs_org_time")
  @@map("api_request_logs")
  @@schema("dashboard_core")
}
