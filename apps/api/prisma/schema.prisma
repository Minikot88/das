generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/database/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["dashboard_core"]
}

model Organization {
  id                        String                   @id @db.VarChar(64)
  code                      String                   @unique @db.VarChar(80)
  name                      String                   @db.VarChar(180)
  status                    String                   @default("active") @db.VarChar(32)
  revision                  Int                      @default(0)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                @map("deleted_at") @db.Timestamptz(3)
  auth_sessions             AuthSession[]
  authentication_audit_logs AuthenticationAuditLog[]
  bi_projects               BiProject[]
  invitations               Invitation[]
  organization_members      OrganizationMember[]
  roles                     Role[]
  user_profiles             UserProfile[]

  @@map("organizations")
  @@schema("dashboard_core")
}

model UserProfile {
  id                        String                   @id @db.VarChar(64)
  organizationId            String                   @map("organization_id") @db.VarChar(64)
  externalUserId            String                   @map("external_user_id") @db.VarChar(191)
  externalAuthProvider      String                   @map("external_auth_provider") @db.VarChar(80)
  email                     String                   @db.VarChar(191)
  displayName               String                   @map("display_name") @db.VarChar(180)
  status                    String                   @default("active") @db.VarChar(32)
  revision                  Int                      @default(0)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  normalizedEmail           String                   @unique(map: "uq_user_profiles_normalized_email") @map("normalized_email") @db.VarChar(191)
  emailVerifiedAt           DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  disabledAt                DateTime?                @map("disabled_at") @db.Timestamptz(3)
  auth_sessions             AuthSession[]
  authentication_audit_logs AuthenticationAuditLog[]
  bi_project_members        BiProjectMember[]
  bi_projects               BiProject[]
  invitations               Invitation[]
  organization_members      OrganizationMember[]
  password_reset_tokens     PasswordResetToken?
  saved_views               SavedView[]
  user_credentials          UserCredential?
  user_preferences          UserPreference[]
  organizations             Organization             @relation(fields: [organizationId], references: [id])
  user_roles                UserRole[]

  @@unique([organizationId, externalAuthProvider, externalUserId], map: "uq_user_profiles_external")
  @@index([organizationId, email], map: "idx_user_profiles_org_email")
  @@map("user_profiles")
  @@schema("dashboard_core")
}

model UserCredential {
  id                String      @id @db.VarChar(64)
  userId            String      @unique(map: "uq_user_credentials_user") @map("user_id") @db.VarChar(64)
  passwordHash      String      @map("password_hash")
  passwordChangedAt DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user_profiles     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
  @@schema("dashboard_core")
}

model AuthSession {
  id                String       @id @db.VarChar(64)
  organizationId    String       @map("organization_id") @db.VarChar(64)
  userId            String       @map("user_id") @db.VarChar(64)
  tokenHash         String       @unique(map: "uq_auth_sessions_token_hash") @map("token_hash") @db.VarChar(64)
  csrfTokenHash     String       @map("csrf_token_hash") @db.Char(64)
  idleExpiresAt     DateTime     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ipHash            String?      @map("ip_hash") @db.Char(64)
  userAgentHash     String?      @map("user_agent_hash") @db.Char(64)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organizations     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user_profiles     UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, createdAt], map: "idx_auth_sessions_user_active")
  @@index([idleExpiresAt, absoluteExpiresAt], map: "idx_auth_sessions_expiry")
  @@map("auth_sessions")
  @@schema("dashboard_core")
}

model OidcLoginTransaction {
  id         String    @id @db.VarChar(64)
  stateHash  String    @unique(map: "uq_oidc_login_transactions_state_hash") @map("state_hash") @db.Char(64)
  returnPath String    @map("return_path") @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt, consumedAt], map: "idx_oidc_login_transactions_expiry")
  @@map("oidc_login_transactions")
  @@schema("dashboard_core")
}

model PasswordResetToken {
  id            String      @id @db.VarChar(64)
  userId        String      @unique(map: "uq_password_reset_tokens_one_active_user", where: raw("((used_at IS NULL) AND (revoked_at IS NULL))")) @map("user_id") @db.VarChar(64)
  tokenHash     String      @unique(map: "uq_password_reset_tokens_hash") @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?   @map("used_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user_profiles UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
  @@schema("dashboard_core")
}

model Invitation {
  id              String       @id @db.VarChar(64)
  organizationId  String       @map("organization_id") @db.VarChar(64)
  projectId       String?      @map("project_id") @db.VarChar(64)
  email           String       @db.VarChar(191)
  normalizedEmail String       @map("normalized_email") @db.VarChar(191)
  role            String       @db.VarChar(32)
  tokenHash       String       @unique(map: "uq_invitations_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdBy       String       @map("created_by") @db.VarChar(64)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user_profiles   UserProfile  @relation(fields: [createdBy], references: [id])
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bi_projects     BiProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, normalizedEmail, createdAt], map: "idx_invitations_org_email")
  @@map("invitations")
  @@schema("dashboard_core")
}

model OrganizationMember {
  id             String       @id @db.VarChar(64)
  organizationId String       @map("organization_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.VarChar(64)
  role           String       @default("member") @db.VarChar(32)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizations  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user_profiles  UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "uq_organization_members_org_user")
  @@index([userId, organizationId], map: "idx_organization_members_user")
  @@map("organization_members")
  @@schema("dashboard_core")
}

model AuthenticationAuditLog {
  id             BigInt        @id @default(autoincrement())
  organizationId String?       @map("organization_id") @db.VarChar(64)
  userId         String?       @map("user_id") @db.VarChar(64)
  requestId      String        @map("request_id") @db.VarChar(64)
  event          String        @db.VarChar(80)
  outcome        String        @db.VarChar(32)
  ipHash         String?       @map("ip_hash") @db.Char(64)
  metadataJson   Json?         @map("metadata_json")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organizations  Organization? @relation(fields: [organizationId], references: [id])
  user_profiles  UserProfile?  @relation(fields: [userId], references: [id])

  @@index([organizationId, occurredAt, id], map: "idx_authentication_audit_org_time")
  @@index([userId, occurredAt, id], map: "idx_authentication_audit_user_time")
  @@map("authentication_audit_logs")
  @@schema("dashboard_core")
}

model Role {
  id               String           @id @db.VarChar(64)
  organizationId   String           @map("organization_id") @db.VarChar(64)
  code             String           @db.VarChar(80)
  name             String           @db.VarChar(180)
  isSystem         Boolean          @default(false) @map("is_system")
  role_permissions RolePermission[]
  organizations    Organization     @relation(fields: [organizationId], references: [id])
  user_roles       UserRole[]

  @@unique([organizationId, code], map: "uq_roles_org_code")
  @@map("roles")
  @@schema("dashboard_core")
}

model Permission {
  id               String           @id @db.VarChar(64)
  code             String           @unique @db.VarChar(120)
  description      String?          @db.VarChar(255)
  role_permissions RolePermission[]

  @@map("permissions")
  @@schema("dashboard_core")
}

model RolePermission {
  id           String     @id @db.VarChar(64)
  roleId       String     @map("role_id") @db.VarChar(64)
  permissionId String     @map("permission_id") @db.VarChar(64)
  permissions  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roles        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permissions")
  @@index([permissionId], map: "idx_role_permissions_permission")
  @@map("role_permissions")
  @@schema("dashboard_core")
}

model UserRole {
  id            String      @id @db.VarChar(64)
  userId        String      @map("user_id") @db.VarChar(64)
  roleId        String      @map("role_id") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  roles         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user_profiles UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uq_user_roles")
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
  @@schema("dashboard_core")
}

model BiProject {
  id                      String                 @id @db.VarChar(64)
  organizationId          String                 @map("organization_id") @db.VarChar(64)
  ownerUserId             String                 @map("owner_user_id") @db.VarChar(64)
  name                    String                 @db.VarChar(180)
  status                  String                 @default("active") @db.VarChar(32)
  revision                Int                    @default(0)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?              @map("deleted_at") @db.Timestamptz(3)
  bi_dashboards           BiDashboard[]
  bi_project_members      BiProjectMember[]
  organizations           Organization           @relation(fields: [organizationId], references: [id])
  user_profiles           UserProfile            @relation(fields: [ownerUserId], references: [id])
  bi_sheets               BiSheet[]
  charts                  Chart[]
  dashboard_share_links   DashboardShareLink[]
  data_source_connections DataSourceConnection[]
  datasets                Dataset[]
  export_jobs             ExportJob[]
  files                   FileRecord[]
  import_jobs             ImportJob[]
  invitations             Invitation[]
  saved_views             SavedView[]
  sql_queries             SqlQuery[]
  sql_query_runs          SqlQueryRun[]
  workspace_contexts      WorkspaceContext[]

  @@unique([organizationId, name], map: "uq_bi_projects_org_name")
  @@index([organizationId, updatedAt, id], map: "idx_bi_projects_org_updated")
  @@map("bi_projects")
  @@schema("dashboard_core")
}

model BiProjectMember {
  id             String      @id @db.VarChar(64)
  organizationId String      @map("organization_id") @db.VarChar(64)
  projectId      String      @map("project_id") @db.VarChar(64)
  userId         String      @map("user_id") @db.VarChar(64)
  role           String      @default("viewer") @db.VarChar(32)
  bi_projects    BiProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user_profiles  UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "uq_bi_project_members")
  @@index([organizationId, userId], map: "idx_bi_project_members_org_user")
  @@map("bi_project_members")
  @@schema("dashboard_core")
}

model BiSheet {
  id                 String             @id @db.VarChar(64)
  organizationId     String             @map("organization_id") @db.VarChar(64)
  projectId          String             @map("project_id") @db.VarChar(64)
  name               String             @db.VarChar(180)
  position           Int                @default(0)
  revision           Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  bi_dashboards      BiDashboard[]
  bi_projects        BiProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace_contexts WorkspaceContext[]

  @@unique([projectId, name], map: "uq_bi_sheets_project_name")
  @@index([projectId, position, id], map: "idx_bi_sheets_project_position")
  @@map("bi_sheets")
  @@schema("dashboard_core")
}

model WorkspaceContext {
  id                String       @id @db.VarChar(64)
  organizationId    String       @map("organization_id") @db.VarChar(64)
  userId            String       @map("user_id") @db.VarChar(64)
  activeProjectId   String?      @map("active_project_id") @db.VarChar(64)
  activeSheetId     String?      @map("active_sheet_id") @db.VarChar(64)
  activeDashboardId String?      @map("active_dashboard_id") @db.VarChar(64)
  revision          Int          @default(0)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  bi_dashboards     BiDashboard? @relation(fields: [activeDashboardId], references: [id])
  bi_projects       BiProject?   @relation(fields: [activeProjectId], references: [id])
  bi_sheets         BiSheet?     @relation(fields: [activeSheetId], references: [id])

  @@unique([organizationId, userId], map: "uq_workspace_contexts_org_user")
  @@map("workspace_contexts")
  @@schema("dashboard_core")
}

model BiDashboard {
  id                    String               @id @db.VarChar(64)
  organizationId        String               @map("organization_id") @db.VarChar(64)
  projectId             String               @map("project_id") @db.VarChar(64)
  sheetId               String?              @map("sheet_id") @db.VarChar(64)
  name                  String               @db.VarChar(180)
  canvasSettingsJson    Json?                @map("canvas_settings_json")
  status                String               @default("draft") @db.VarChar(32)
  revision              Int                  @default(0)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(3)
  bi_projects           BiProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bi_sheets             BiSheet?             @relation(fields: [sheetId], references: [id])
  dashboard_share_links DashboardShareLink[]
  dashboard_versions    DashboardVersion[]
  dashboard_widgets     DashboardWidget[]
  saved_views           SavedView[]
  workspace_contexts    WorkspaceContext[]

  @@index([projectId, updatedAt, id], map: "idx_bi_dashboards_project_updated")
  @@map("bi_dashboards")
  @@schema("dashboard_core")
}

model DashboardVersion {
  id             String      @id @db.VarChar(64)
  organizationId String      @map("organization_id") @db.VarChar(64)
  dashboardId    String      @map("dashboard_id") @db.VarChar(64)
  revision       Int
  snapshotJson   Json        @map("snapshot_json")
  createdBy      String?     @map("created_by") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  bi_dashboards  BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, revision], map: "uq_dashboard_versions_revision")
  @@map("dashboard_versions")
  @@schema("dashboard_core")
}

model DashboardWidget {
  id             String      @id @db.VarChar(64)
  organizationId String      @map("organization_id") @db.VarChar(64)
  dashboardId    String      @map("dashboard_id") @db.VarChar(64)
  chartId        String?     @map("chart_id") @db.VarChar(64)
  type           String      @db.VarChar(40)
  x              Int
  y              Int
  width          Int
  height         Int
  zIndex         Int         @default(0) @map("z_index")
  configJson     Json?       @map("config_json")
  revision       Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  charts         Chart?      @relation(fields: [chartId], references: [id])
  bi_dashboards  BiDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, zIndex, id], map: "idx_dashboard_widgets_order")
  @@index([chartId], map: "idx_dashboard_widgets_chart")
  @@map("dashboard_widgets")
  @@schema("dashboard_core")
}

model SavedView {
  id             String       @id @db.VarChar(64)
  organizationId String       @map("organization_id") @db.VarChar(64)
  projectId      String       @map("project_id") @db.VarChar(64)
  dashboardId    String?      @map("dashboard_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.VarChar(64)
  name           String       @db.VarChar(180)
  stateJson      Json         @map("state_json")
  revision       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  bi_dashboards  BiDashboard? @relation(fields: [dashboardId], references: [id])
  bi_projects    BiProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user_profiles  UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId, updatedAt], map: "idx_saved_views_project_user")
  @@map("saved_views")
  @@schema("dashboard_core")
}

model ChartType {
  id                      String                 @id @db.VarChar(64)
  code                    String                 @unique @db.VarChar(100)
  name                    String                 @db.VarChar(180)
  renderer                String                 @db.VarChar(40)
  metadataJson            Json?                  @map("metadata_json")
  chart_templates         ChartTemplate[]
  chart_type_requirements ChartTypeRequirement[]
  charts                  Chart[]

  @@map("chart_types")
  @@schema("dashboard_core")
}

model ChartTypeRequirement {
  id          String    @id @db.VarChar(64)
  chartTypeId String    @map("chart_type_id") @db.VarChar(64)
  slot        String    @db.VarChar(80)
  minFields   Int       @default(0) @map("min_fields")
  maxFields   Int?      @map("max_fields")
  rulesJson   Json?     @map("rules_json")
  chart_types ChartType @relation(fields: [chartTypeId], references: [id], onDelete: Cascade)

  @@unique([chartTypeId, slot], map: "uq_chart_type_requirements_slot")
  @@map("chart_type_requirements")
  @@schema("dashboard_core")
}

model ChartTemplate {
  id                  String    @id @db.VarChar(64)
  chartTypeId         String    @map("chart_type_id") @db.VarChar(64)
  code                String    @unique @db.VarChar(100)
  name                String    @db.VarChar(180)
  defaultMappingJson  Json?     @map("default_mapping_json")
  defaultSettingsJson Json?     @map("default_settings_json")
  chart_types         ChartType @relation(fields: [chartTypeId], references: [id])

  @@index([chartTypeId], map: "idx_chart_templates_type")
  @@map("chart_templates")
  @@schema("dashboard_core")
}

model Chart {
  id                  String            @id @db.VarChar(64)
  organizationId      String            @map("organization_id") @db.VarChar(64)
  projectId           String            @map("project_id") @db.VarChar(64)
  datasetId           String?           @map("dataset_id") @db.VarChar(64)
  chartTypeId         String?           @map("chart_type_id") @db.VarChar(64)
  name                String            @db.VarChar(180)
  engine              String            @default("chartjs") @db.VarChar(40)
  mappingJson         Json?             @map("mapping_json")
  settingsJson        Json?             @map("settings_json")
  filtersJson         Json?             @map("filters_json")
  configJson          Json?             @map("config_json")
  queryDefinitionJson Json?             @map("query_definition_json")
  dataContractJson    Json?             @map("data_contract_json")
  revision            Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  chart_versions      ChartVersion[]
  chart_types         ChartType?        @relation(fields: [chartTypeId], references: [id])
  datasets            Dataset?          @relation(fields: [datasetId], references: [id])
  bi_projects         BiProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dashboard_widgets   DashboardWidget[]

  @@index([projectId, updatedAt, id], map: "idx_charts_project_updated")
  @@index([datasetId], map: "idx_charts_dataset")
  @@map("charts")
  @@schema("dashboard_core")
}

model ChartVersion {
  id           String   @id @db.VarChar(64)
  chartId      String   @map("chart_id") @db.VarChar(64)
  revision     Int
  snapshotJson Json     @map("snapshot_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  charts       Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, revision], map: "uq_chart_versions_revision")
  @@map("chart_versions")
  @@schema("dashboard_core")
}

model DataSourceType {
  id                      String                 @id @db.VarChar(64)
  code                    String                 @unique @db.VarChar(80)
  name                    String                 @db.VarChar(120)
  implementation          String                 @default("not_implemented") @db.VarChar(40)
  capabilitiesJson        Json?                  @map("capabilities_json")
  data_source_connections DataSourceConnection[]

  @@map("data_source_types")
  @@schema("dashboard_core")
}

model DataSourceConnection {
  id                            String                     @id @db.VarChar(64)
  organizationId                String                     @map("organization_id") @db.VarChar(64)
