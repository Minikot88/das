APP_ENV=production
NODE_ENV=production
APP_DOMAIN=dash.triup-psu.space
APP_URL=https://dash.triup-psu.space
EMBED_ALLOWED_ORIGINS='self'
API_URL=https://dash.triup-psu.space/api
AUTH_MODE=external
AUTH_EXTERNAL_PROVIDER=psu-sso
AUTH_JWKS_URL=https://psusso.psu.ac.th/application/o/research-triupact/jwks/
AUTH_ISSUER=https://psusso.psu.ac.th/application/o/research-triupact/
AUTH_AUDIENCE=<psu-sso-client-id>
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_CLOCK_SKEW_SECONDS=60
OIDC_AUTHORIZATION_URL=https://psusso.psu.ac.th/application/o/authorize/
OIDC_TOKEN_URL=https://psusso.psu.ac.th/application/o/token/
OIDC_USERINFO_URL=https://psusso.psu.ac.th/application/o/userinfo/
OIDC_CLIENT_ID=<psu-sso-client-id>
OIDC_CLIENT_SECRET=<psu-sso-client-secret>
OIDC_REDIRECT_URI=https://dash.triup-psu.space/api/auth/callback
OIDC_SCOPES=openid profile email
SESSION_SECRET=<random-secret-at-least-32-bytes>
SESSION_COOKIE_NAME=dashboardmini_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
VITE_EXTERNAL_SESSION_REQUIRED_URL=/api/auth/login
POSTGRES_DB=dashboardmini
POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=CHANGE_ME_RUNTIME_DATABASE_PASSWORD
POSTGRES_MIGRATION_USER=dashboard_migrator
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_DATABASE_PASSWORD
DATABASE_URL=postgresql://dashboard_app:CHANGE_ME@postgres:5432/dashboardmini?schema=dashboard_core
MIGRATION_DATABASE_URL=postgresql://dashboard_migrator:CHANGE_ME@postgres:5432/dashboardmini?schema=dashboard_core
SECRET_ENCRYPTION_KEY=CHANGE_ME_WITH_A_32_BYTE_BASE64_KEY
CORS_ALLOWED_ORIGINS=https://dash.triup-psu.space
DEBUG=false
DEMO_CONNECTOR_ENABLED=false
INCLUDE_DEMO_SEED=false
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=DashboardMiniBi <noreply@example.com>
SMTP_SECURE=false
BACKUP_STORAGE_PROVIDER=s3
BACKUP_STORAGE_BUCKET=dashboard-mini-bi-backups
BACKUP_STORAGE_ENDPOINT=https://s3.example.com
BACKUP_STORAGE_REGION=ap-southeast-1
BACKUP_STORAGE_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
BACKUP_STORAGE_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
BACKUP_RETENTION_DAYS=30
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_WITH_A_32_BYTE_METRICS_TOKEN
METRICS_TOKEN_FILE=./secrets/metrics-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
LOG_LEVEL=info
TLS_CERT_PATH=./secrets/tls/fullchain.pem
TLS_KEY_PATH=./secrets/tls/privkey.pem
