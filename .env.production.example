APP_ENV=production
NODE_ENV=production
APP_DOMAIN=bi.example.com
APP_URL=https://bi.example.com
EMBED_ALLOWED_ORIGINS='self'
API_URL=https://bi.example.com/api
AUTH_PROVIDER=database
POSTGRES_DB=dashboard_mini_bi
POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=CHANGE_ME_RUNTIME_DATABASE_PASSWORD
POSTGRES_MIGRATION_USER=dashboard_migrator
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_DATABASE_PASSWORD
DATABASE_URL=postgresql://dashboard_app:CHANGE_ME@postgres:5432/dashboard_mini_bi?schema=public
MIGRATION_DATABASE_URL=postgresql://dashboard_migrator:CHANGE_ME@postgres:5432/dashboard_mini_bi?schema=public
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
COOKIE_SECRET=CHANGE_ME_WITH_A_DIFFERENT_32_BYTE_SECRET
SECRET_ENCRYPTION_KEY=CHANGE_ME_WITH_A_32_BYTE_BASE64_KEY
CSRF_SECRET=CHANGE_ME_WITH_ANOTHER_32_BYTE_SECRET
CORS_ALLOWED_ORIGINS=https://bi.example.com
COOKIE_SECURE=true
PUBLIC_REGISTRATION_ENABLED=false
DEBUG=false
DEMO_CONNECTOR_ENABLED=false
INCLUDE_DEMO_SEED=false
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=DashboardMiniBi <noreply@example.com>
SMTP_SECURE=false
BACKUP_STORAGE_PROVIDER=s3
BACKUP_STORAGE_BUCKET=dashboard-mini-bi-backups
BACKUP_STORAGE_ENDPOINT=https://s3.example.com
BACKUP_STORAGE_REGION=ap-southeast-1
BACKUP_STORAGE_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
BACKUP_STORAGE_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
BACKUP_RETENTION_DAYS=30
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_WITH_A_32_BYTE_METRICS_TOKEN
METRICS_TOKEN_FILE=./secrets/metrics-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
LOG_LEVEL=info
TLS_CERT_PATH=./secrets/tls/fullchain.pem
TLS_KEY_PATH=./secrets/tls/privkey.pem
