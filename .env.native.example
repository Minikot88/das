NODE_ENV=production
APP_ENV=production
DEPLOYMENT_ENV=staging
APP_DOMAIN=dash.triup-psu.space
APP_URL=https://dash.triup-psu.space
AUTH_MODE=external
AUTH_EXTERNAL_PROVIDER=<main-website-provider-name>
AUTH_JWKS_URL=<main-website-https-jwks-url>
AUTH_ISSUER=<main-website-https-issuer>
AUTH_AUDIENCE=dashboardmini
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_CLOCK_SKEW_SECONDS=60
AUTH_ORGANIZATION_CLAIM=org_id
AUTH_ROLES_CLAIM=roles
AUTH_SCOPES_CLAIM=scopes
VITE_EXTERNAL_SESSION_REQUIRED_URL=<main-website-https-session-required-url>
VITE_USE_MOCK=false
PORT=4020
DATABASE_URL=<runtime-postgresql-url>
MIGRATION_DATABASE_URL=<migration-postgresql-url>
SECRET_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
CORS_ALLOWED_ORIGINS=https://dash.triup-psu.space
INCLUDE_DEMO_SEED=false
DEMO_CONNECTOR_ENABLED=false
DEBUG=false
FILE_STORAGE_PATH=/home/ubuntu/infra/projects/dashboardmini/shared/storage
MAX_UPLOAD_SIZE=5000000
QUERY_TIMEOUT=30000
QUERY_ROW_LIMIT=50000
DATABASE_POOL_MAX=10
LOG_LEVEL=info
SMTP_ENABLED=false
METRICS_ENABLED=true
METRICS_TOKEN=<random-secret-at-least-32-bytes>
